<% layout('/layouts/boilerplate') %>


<div class="row mt-3">

    <div class="col-8 offset-2">

        <h3>Edit Listing</h3>


        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            enctype="multipart/form-data"
        >


            <!-- TITLE -->

            <div class="mb-3">

                <label class="form-label">
                    Title
                </label>

                <input
                    type="text"
                    name="listing[title]"
                    class="form-control"
                    value="<%= listing.title %>"
                    required
                >

            </div>


            <!-- DESCRIPTION -->

            <div class="mb-3">

                <label class="form-label">
                    Description
                </label>

                <textarea
                    name="listing[description]"
                    class="form-control"
                    rows="4"
                    required
                ><%= listing.description %></textarea>

            </div>


            <!-- CURRENT IMAGE -->

            <% if (listing.image && listing.image.url) { %>

                <div class="mb-3">

                    <label class="form-label">
                        Current Image
                    </label>

                    <br>

                    <img
                        src="<%= listing.image.url %>"
                        alt="Listing Image"
                        style="
                            width: 200px;
                            height: 150px;
                            object-fit: cover;
                            border-radius: 10px;
                        "
                    >

                </div>

            <% } %>


            <!-- NEW IMAGE -->

            <div class="mb-3">

                <label
                    for="image"
                    class="form-label"
                >
                    Upload New Image
                </label>

                <input
                    type="file"
                    name="image"
                    id="image"
                    class="form-control"
                    accept="image/png, image/jpeg, image/jpg, image/webp"
                >

                <small class="text-muted">
                    Leave empty if you want to keep the current image.
                </small>

            </div>


            <!-- PRICE -->

            <div class="mb-3">

                <label class="form-label">
                    Price
                </label>

                <input
                    type="number"
                    name="listing[price]"
                    class="form-control"
                    value="<%= listing.price %>"
                    required
                >

            </div>


            <!-- COUNTRY -->

            <div class="mb-3">

                <label class="form-label">
                    Country
                </label>

                <input
                    type="text"
                    name="listing[country]"
                    class="form-control"
                    value="<%= listing.country %>"
                    required
                >

            </div>


            <!-- LOCATION -->

            <div class="mb-3">

                <label class="form-label">
                    Location
                </label>

                <input
                    type="text"
                    name="listing[location]"
                    class="form-control"
                    value="<%= listing.location %>"
                    required
                >

            </div>


            <!-- BUTTON -->

            <button class="btn btn-danger">
                Update
            </button>


        </form>

    </div>

</div>